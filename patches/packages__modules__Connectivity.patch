+    if (kernelVer < KVER(4, 19, 0) || kernelVer >= KVER(4, 20, 0)) return false;
+    char sdk[PROP_VALUE_MAX] = {};
+    return __system_property_get("ro.vendor.build.version.sdk", sdk) > 0 &&
+            !strcmp(sdk, "30");
+}
