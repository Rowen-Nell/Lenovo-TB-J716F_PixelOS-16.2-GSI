+static bool legacyHdrProtocolEnabled() {
+    return base::GetProperty("ro.product.vendor.device", "") == "p11_pro_plus" &&
+            base::GetBoolProperty("ro.surface_flinger.tb04_legacy_hdr_gpu", false);
