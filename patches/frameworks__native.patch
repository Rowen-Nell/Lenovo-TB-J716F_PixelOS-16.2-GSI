+
+static int32_t getLegacyHdrFrameFlags(frontend::LayerSnapshotBuilder& snapshots,
+                                      compositionengine::Display* display) {
+    using namespace compositionengine::impl::legacy_hdr;
+    if (!legacyHdrProtocolEnabled()) return 0;
+    int32_t flags = kFrameAnnotated;
+    snapshots.forEachVisibleSnapshot(
+            [&](const std::unique_ptr<frontend::LayerSnapshot>& snapshot)
+                    FTL_FAKE_GUARD(kMainThreadContext) {
+                if (!snapshot->isVisible || !display->includesLayer(snapshot->outputFilter)) return;
+                if (snapshot->hasProtectedContent || snapshot->sidebandStream != nullptr ||
+                    !snapshot->dimmingEnabled) {
+                    flags |= kUnsupportedMix;
+                }
+                const auto format = snapshot->buffer
+                        ? std::make_optional(static_cast<ui::PixelFormat>(
+                                  snapshot->buffer->getPixelFormat()))
+                        : std::nullopt;
+                if (getHdrRenderType(snapshot->dataspace, format, snapshot->desiredHdrSdrRatio) !=
+                    HdrRenderType::SDR) {
+                    flags |= kRealHdrContent;
+                }
+            });
+    return flags;
+}
