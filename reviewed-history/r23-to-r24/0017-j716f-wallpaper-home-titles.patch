diff --git a/pixelos_tb03_arm64_ext4.mk b/pixelos_tb03_arm64_ext4.mk
--- a/pixelos_tb03_arm64_ext4.mk
+++ b/pixelos_tb03_arm64_ext4.mk
@@ -77,3 +77,6 @@
 # J716F uses the stock non-GKI 4.19 kernel and runtime CC, not UFFD/CMC.
 # Match dexpreopt artifacts to this device; do not replace libart or the kernel.
 PRODUCT_ENABLE_UFFD_GC := false
+
+# Scoped Google wallpaper homepage titles; no shared style or subpage override.
+PRODUCT_PACKAGES += Tb24WallpaperHomeTypographyOverlay
diff --git a/overlay/Tb24WallpaperHome/Android.mk b/overlay/Tb24WallpaperHome/Android.mk
new file mode 100644
--- /dev/null
+++ b/overlay/Tb24WallpaperHome/Android.mk
@@ -0,0 +1,15 @@
+# SPDX-License-Identifier: Apache-2.0
+LOCAL_PATH := $(call my-dir)
+include $(CLEAR_VARS)
+LOCAL_PACKAGE_NAME := Tb24WallpaperHomeTypographyOverlay
+LOCAL_PRODUCT_MODULE := true
+LOCAL_SDK_VERSION := current
+LOCAL_CERTIFICATE := platform
+LOCAL_RESOURCE_DIR := $(LOCAL_PATH)/res
+# Use the unchanged Google prebuilt as an actual aapt include, not a fake resource stub.
+tb24_wallpaper_apk := vendor/pixel/themepicker/common/proprietary/system_ext/priv-app/WallpaperPickerGoogleRelease/WallpaperPickerGoogleRelease.apk
+LOCAL_AAPT_FLAGS += -I $(tb24_wallpaper_apk)
+LOCAL_ADDITIONAL_DEPENDENCIES := $(tb24_wallpaper_apk)
+include $(BUILD_RRO_PACKAGE)
+# Track the private resource ABI on the real link edge as well as the signed APK.
+$(call intermediates-dir-for,APPS,Tb24WallpaperHomeTypographyOverlay,,COMMON)/package-res.apk: $(tb24_wallpaper_apk)
